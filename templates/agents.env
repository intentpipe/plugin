# Workspace config. Shell-sourceable. Validated by scripts/preflight.sh.
PROJECT_NAME=myproject
DEFAULT_BRANCH=main

# How finished tasks land. local = squash-merge to DEFAULT_BRANCH (solo repos).
# pr = push the task branch and open a GitHub PR (shared repos; needs `gh`
# authenticated and an origin remote — tasks then complete via task.sh sync
# once a human merges the PR).
DONE=local

# Repo names (space-separated). For each name X: REPO_X = path relative to
# this file (repos are siblings of intentpipe/, hence ../), VERIFY_X = one
# command that builds, lints, and tests.
REPOS="app"
REPO_app=../app
VERIFY_app="echo 'TODO: set verify command' && false"

# Optional per repo: TEST_X = the test runner with test paths appended — what
# the implementer runs after each change and the reviewer runs for its checks
# (`verify.sh --tests X <paths>`), instead of the whole VERIFY_X. Unset => the
# inner loop pays the full verify every time.
# TEST_app="flutter test"
# TEST_api="uv run pytest -q"

# Optional per repo: SMOKE_X = one command proving the built app actually starts
# and answers — VERIFY_X only proves it compiles and its tests pass, so a startup
# path (a migration failing on existing data, a bad env var, an import error at
# boot) ships green. Runs after VERIFY_X passes, killed after SMOKE_TIMEOUT
# (default 300s). Unset => skipped. Unlike verify, this one has side effects: it
# starts things. Force a real boot — `up -d` on an already-running container is a
# no-op that proves nothing.
# SMOKE_app='docker compose up -d --force-recreate --wait api'

# Optional: one command to run when a task lands, with the branch that now
# carries the work as its argument (the PR branch, the feature branch it
# integrated into, or DEFAULT_BRANCH under DONE=local). `done` puts every repo
# back on DEFAULT_BRANCH, so without this anything serving the project keeps
# serving the mainline. Detached and tolerant: it never delays or fails the
# task, and its output goes to tasks/_after-done.log. Unset => nothing runs.
# $INTENTPIPE_WORKSPACE (this directory) and $INTENTPIPE_BRANCH are in the hook's environment —
# SINGLE-quote the command so they expand when it runs, not when this file is read.
# AFTER_DONE='$HOME/intentpipe/orchestrator/system-scripts/checkout.py --refresh "$INTENTPIPE_WORKSPACE"'

# Optional: notify.sh → Telegram. Bot token + chat id are shared across projects
# (keep them in ~/.agent-orchestrator/telegram.env, or set here); the topic id is
# per-project — the forum topic this project's escalations report into.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TOPIC_ID=

# Optional: /plan creates one Linear issue per approved plan run and embeds its
# key in every feature slug, so each PR auto-links to the issue. Needs DONE=pr
# (Linear links via the PR branch) and LINEAR_API_KEY (shared, in
# ~/.agent-orchestrator/linear.env). Unset ⇒ off.
# LINEAR_TEAM_KEY=ENG
